push_main=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main) push_main=1 ;;
  esac
done

echo "husky (pre-push) - running checks..."

npm run check || { echo "husky (pre-push) - astro check failed"; exit 1; }
npm run lint || { echo "husky (pre-push) - eslint failed"; exit 1; }
npm run format:check || { echo "husky (pre-push) - prettier check failed (run 'npm run format' to fix)"; exit 1; }

if [ "$push_main" = 1 ]; then
  echo "husky (pre-push) - pushing to main: running the full accessibility suite..."
  npm run a11y:ci || { echo "husky (pre-push) - accessibility checks failed"; exit 1; }
fi

echo "husky (pre-push) - all checks passed"
