---
import Lab, {type Technology} from "./Lab.astro";

interface LabData {
  id: string;
  url: string;
  repo: string;
  name: string;
  desc: string;
  technologies: Technology[];
}

const labs: LabData[] = [
  {
    id: "lireddit",
    url: "https://lireddit.lazzaroni.io/",
    repo: "https://github.com/Fakkio/lireddit",
    name: "Lireddit",
    desc: "un limitato clone di un forum tipo reddit",
    technologies: [
      "react",
      "typescript",
      "graphql",
      "node",
      "postgres",
      "docker",
    ],
  },
  {
    id: "3d-business-card",
    url: "https://fakkio.github.io/3d-business-card/",
    repo: "https://github.com/Fakkio/3d-business-card",
    name: "3d Business Card",
    desc: "Un biglietto da visita visto in 3d",
    technologies: ["js", "css", "html"],
  },
  {
    // Intentional delta (map #1): drops React and swaps Gatsby for Astro —
    // after the port the old [react, gatsby, node] list would be false.
    id: "fabiolazzaroni-dev",
    url: "https://fabiolazzaroni.dev/",
    repo: "https://github.com/Fakkio/fabiolazzaroni.dev",
    name: "fabiolazzaroni.dev",
    desc: "questo sito!",
    technologies: ["node", "astro"],
  },
];
---

<ul class="labs">
  {labs.map((lab) => <Lab {...lab} />)}
</ul>

<style>
  .labs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
