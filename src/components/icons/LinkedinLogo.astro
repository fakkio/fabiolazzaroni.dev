---
// Theme-reactive fill via per-icon custom properties, per #8. The icon glyph's
// light value reuses --color-invertedBackground (matches today's behaviour);
// its dark value is a literal white, not the token, same as the source.
import Icon from "./Icon.astro";

type Props = astroHTML.JSX.SVGAttributes;

const {class: className, ...rest} = Astro.props;
---

<Icon viewBox="0 0 31.798 32" class:list={["animateFill", className]} {...rest}>
  <path
    class="linkedin-bg"
    d="M0 2.292A2.322 2.322 0 012.35 0h27.098a2.322 2.322 0 012.35 2.292v27.416A2.322 2.322 0 0129.448 32H2.35A2.322 2.322 0 010 29.708z"
  ></path>
  <path
    class="linkedin-mark"
    d="M9.639 26.787v-14.45H4.836v14.45zM7.238 10.365a2.504 2.504 0 10.031-4.993 2.503 2.503 0 10-.063 4.993h.032z"
  ></path>
  <path
    class="linkedin-mark"
    d="M12.297 26.787h4.802v-8.07a3.292 3.292 0 01.158-1.171 2.629 2.629 0 012.465-1.757c1.738 0 2.433 1.326 2.433 3.268v7.73h4.802v-8.285c0-4.438-2.37-6.504-5.53-6.504a4.784 4.784 0 00-4.36 2.435h.032v-2.095h-4.802c.063 1.355 0 14.45 0 14.45z"
  ></path>
</Icon>

<style>
  .linkedin-bg {
    --linkedin-bg-fill: #ffffff;
    fill: var(--linkedin-bg-fill);
  }
  .linkedin-mark {
    --linkedin-mark-fill: var(--color-invertedBackground);
    fill: var(--linkedin-mark-fill);
  }

  :global([data-theme="dark"]) .linkedin-bg {
    --linkedin-bg-fill: #2e6897;
  }
  :global([data-theme="dark"]) .linkedin-mark {
    --linkedin-mark-fill: #ffffff;
  }
</style>
