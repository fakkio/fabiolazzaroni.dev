---
import AstroLogo from "./icons/AstroLogo.astro";
import CSharpLogo from "./icons/CSharpLogo.astro";
import CssLogo from "./icons/CssLogo.astro";
import DockerLogo from "./icons/DockerLogo.astro";
import DotnetLogo from "./icons/DotnetLogo.astro";
import GitHubLogo from "./icons/GitHubLogo.astro";
import GraphqlLogo from "./icons/GraphqlLogo.astro";
import HTMLLogo from "./icons/HTMLLogo.astro";
import JavaScriptLogo from "./icons/JavaScriptLogo.astro";
import NodejsLogo from "./icons/NodejsLogo.astro";
import PostgresLogo from "./icons/PostgresLogo.astro";
import ReactLogo from "./icons/ReactLogo.astro";
import TypescriptLogo from "./icons/TypescriptLogo.astro";

// Labels follow official branding here (ReactJs -> React, GraphQl -> GraphQL)
// — Bio.astro's own mentions of these technologies are untouched, since that
// fix was scoped to this list alone.
interface TechnologyEntry {
  component: (props: {idPrefix: string; "aria-label": string}) => unknown;
  label: string;
}

const TECHNOLOGIES = {
  react: {component: ReactLogo, label: "React"},
  typescript: {component: TypescriptLogo, label: "TypeScript"},
  graphql: {component: GraphqlLogo, label: "GraphQL"},
  node: {component: NodejsLogo, label: "Node.js"},
  postgres: {component: PostgresLogo, label: "PostgreSQL"},
  docker: {component: DockerLogo, label: "Docker"},
  js: {component: JavaScriptLogo, label: "JavaScript"},
  css: {component: CssLogo, label: "CSS"},
  html: {component: HTMLLogo, label: "HTML"},
  astro: {component: AstroLogo, label: "Astro"},
  csharp: {component: CSharpLogo, label: "C#"},
  dotnet: {component: DotnetLogo, label: ".NET"},
} satisfies Record<string, TechnologyEntry>;

export type Technology = keyof typeof TECHNOLOGIES;

interface Props {
  desc: string;
  id: string;
  name: string;
  repo: string;
  technologies: Technology[];
  url: string;
}

const {desc, id, name, repo, technologies, url} = Astro.props;
// Every logo takes this prefix; the ones that define their own SVG gradients or
// clip paths use it to namespace them, the rest ignore it.
const idPrefix = `lab-${id}`;
---

<li class="lab">
  <h3 class="title">
    <a href={url} class="stretchedLink">
      <span>{name}</span>
    </a>
    <a href={repo} class="onlyIcon">
      <GitHubLogo aria-label="repository github" />
    </a>
  </h3>
  <p class="description">{desc}</p>
  <ul class="technologiesList">
    {
      technologies.map((technology) => {
        const {component: Logo, label} = TECHNOLOGIES[technology];
        return (
          <li>
            <Logo idPrefix={idPrefix} aria-label={label} />
          </li>
        );
      })
    }
  </ul>
</li>

<style>
  .lab {
    /* Explicit now: this used to only contain the stretched-link overlay
       (a.stretchedLink::after) because backdrop-filter happens to also
       create a containing block. */
    position: relative;
    padding: 1rem;
    border-radius: 0.5rem;
    background: var(--color-bgTranslucent)
      linear-gradient(to right bottom, #ffffff11, #ffffff00, #00000011);
    backdrop-filter: blur(3px);
    box-shadow:
      0 1.6px 3.6px 0 rgba(0, 0, 0, 0.132),
      0 0.3px 0.9px 0 rgba(0, 0, 0, 0.108);
    border: 1px solid var(--color-muted);
    margin-bottom: 1rem;
    transition:
      background-color var(--theme-transition-duration),
      border var(--theme-transition-duration);
  }

  .lab:last-child {
    margin-bottom: 0;
  }

  .title {
    display: flex;
    justify-content: space-between;
    font-size: 1.25rem;
  }

  .description {
    margin-bottom: 0.5rem;
  }

  .technologiesList {
    list-style: none;
    margin: 0;
    padding: 0;
    margin-bottom: 0;
    display: flex;
    gap: 0.5rem;
  }

  .lab :global(.onlyIcon) {
    /* Explicit now: this used to work only because .title is a flex
       container, which grants z-index to a statically-positioned child. */
    position: relative;
    z-index: 2;
  }
</style>
