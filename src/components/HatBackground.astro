---
import hatTiling from "../assets/hat-tiling.svg?raw";
---

<div class="hat-background" set:html={hatTiling} />

<style>
  .hat-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 0.4;
  }

  .hat-background :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hat-background :global(.hat-accent) {
    fill: var(--color-hatAccent);
  }

  .hat-background :global(.hat-base) {
    fill: var(--color-hatBase);
  }

  .hat-background :global(.hat-accent),
  .hat-background :global(.hat-base) {
    stroke: var(--color-hatLine);
    stroke-width: 0.05;
    transition:
      fill var(--theme-transition-duration),
      stroke var(--theme-transition-duration);
  }
</style>
